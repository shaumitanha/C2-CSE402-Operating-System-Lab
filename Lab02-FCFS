processes = ["P3", "P2", "P0", "P1", "P4"]
arrival_time = [1, 2, 3, 5, 6]
burst_time = [2, 2, 1, 3, 3]

n = len(processes)

completion_time = [0] * n
turnaround_time = [0] * n
waiting_time = [0] * n

current_time = 0

for i in range(n):
    if current_time < arrival_time[i]:
        current_time = arrival_time[i]
    
    completion_time[i] = current_time + burst_time[i]
    current_time = completion_time[i]
    
    turnaround_time[i] = completion_time[i] - arrival_time[i]
    waiting_time[i] = turnaround_time[i] - burst_time[i]

print(f"{'Process':<10}{'AT':<8}{'BT':<8}{'CT':<8}{'TAT':<8}{'WT':<8}")
print("-" * 50)

for i in range(n):
    print(f"{processes[i]:<10}{arrival_time[i]:<8}{burst_time[i]:<8}"
          f"{completion_time[i]:<8}{turnaround_time[i]:<8}{waiting_time[i]:<8}")

avg_wt = sum(waiting_time) / n
avg_tat = sum(turnaround_time) / n

print("-" * 50)
print(f"Average Waiting Time     = {avg_wt:.2f}")
print(f"Average Turnaround Time  = {avg_tat:.2f}")
